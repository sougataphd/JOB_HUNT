# Copy to .env and fill in real values. Never commit .env (rules.md §Secrets Management).
# Full reference: config.md §Environment Variables

# Required if the anthropic provider is enabled in config/agents.yaml
ANTHROPIC_API_KEY=

# Required if the openai provider is enabled in config/agents.yaml
OPENAI_API_KEY=

# Required if the ollama (local) provider is enabled
OLLAMA_HOST=http://localhost:11434

# Optional overrides
JOBHUNT_DATA_DIR=./data
JOBHUNT_LOG_LEVEL=INFO
# Set to 1 to opt into DEBUG-level LLM prompt/response body logging (design.md §9). Off by default.
JOBHUNT_LOG_LLM_BODIES=0
JOBHUNT_ENV=dev

# --- LinkedIn skill (.claude/skills/linkedin) — all optional -----------------
# Read side: profile/post/engagement data via Apify (no-cookies scrapers).
# Sign up free ($5/mo credit): https://console.apify.com/sign-up
# Token: https://console.apify.com/settings/integrations
# Without it, li-profile/li-comment fall back to asking you to paste text.
APIFY_TOKEN=

# Write side: lets an APPROVED draft actually publish via Publora instead of
# printing a copy-paste block. Sign up free (15 posts/mo): https://app.publora.com/signup
# Requires both vars set together.
PUBLORA_API_KEY=
LINKEDIN_PLATFORM_ID=
